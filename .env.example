# Choose: deepseek, kimi, or local
API_PROVIDER=deepseek

# Fill the provider you use. Leave unused providers blank.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

# Optional: QQ Mail account and authorization code for the daily email workflow.
EMAIL_USER=
EMAIL_PASS=
ARXIV_MAIL_FOLDER=INBOX

# Optional: comma-separated report/tunnel notification recipients.
EMAIL_RECIPIENTS=

# Optional: WeChat Public Account publishing.
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_THUMB_MEDIA_ID=
WECHAT_AUTHOR=Arxiv Classify

# Optional: WebUI write access and cookie settings.
ARXIV_WEBUI_WRITE_TOKEN=
ARXIV_WEBUI_SESSION_SECRET=
ARXIV_WEBUI_COOKIE_SECURE=false
